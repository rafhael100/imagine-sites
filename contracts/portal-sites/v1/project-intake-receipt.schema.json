{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native Sites pending project intake receipt v1",
  "description": "Stable receipt of a committed pending request. Does not attest payment, production, client acceptance or publication; recorded does not distinguish first receipt from replay.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tenantRef", "orderRef", "contractRef", "contractRevision", "productCode", "operationId", "idempotencyKey", "siteRef", "commandDigest", "status", "state", "authorityVerified", "clientAccepted", "canPublish"],
  "$defs": {"reference": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}},
  "properties": {
    "schemaVersion": {"const": "sites.project-intake.receipt.v1"},
    "tenantRef": {"$ref": "#/$defs/reference"},
    "orderRef": {"$ref": "#/$defs/reference"},
    "contractRef": {"$ref": "#/$defs/reference"},
    "contractRevision": {"type": "integer", "minimum": 1},
    "productCode": {"enum": ["onepage", "landing_page"]},
    "operationId": {"$ref": "#/$defs/reference"},
    "idempotencyKey": {"$ref": "#/$defs/reference"},
    "siteRef": {"type": "string", "pattern": "^[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}$"},
    "commandDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"const": "recorded"},
    "state": {"const": "awaiting_official_authority"},
    "authorityVerified": {"const": false},
    "clientAccepted": {"const": false},
    "canPublish": {"const": false}
  }
}
