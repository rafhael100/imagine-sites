  "components": {
    "messages": {
      "SiteEvent": {
        "name": "SiteEvent",
        "summary": "Minimal versioned metadata without lead or briefing",
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "eventId",
            "eventType",
            "tenantRef",
            "siteRef",
            "resourceRevision",
            "occurredAt",
            "issuer",
            "correlationRef"
