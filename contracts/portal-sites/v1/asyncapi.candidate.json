            "schemaVersion": {
              "const": "1"
            },
            "eventId": {
              "type": "string"
            },
            "eventType": {
              "type": "string",
              "enum": [
                "sites.project.requested.v1",
                "sites.release.ready.v1",
                "sites.publication.observed.v1",
                "sites.delivery.eligible.v1",
                "sites.authorization.revoked.v1"
              ]
            },
            "tenantRef": {
              "type": "string"
            },
            "siteRef": {
              "type": "string"
            },
            "resourceRevision": {
              "type": "integer",
              "minimum": 1
            },
            "occurredAt": {
              "type": "string",
              "format": "date-time"
            },
            "issuer": {
              "type": "string"
            },
            "correlationRef": {
              "type": "string"
            },
            "payloadRef": {
              "type": "string",
              "description": "Opaque reference to private storage; never raw personal payload"
            }
          }
        }
      }
    }
